#!/bin/bash
# =============================================================================
# Orion-Sentinel-HomeCore Operator CLI (orionctl)
# =============================================================================
# A simple operator CLI for managing HomeCore services.
# =============================================================================

set -euo pipefail

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
NC='\033[0m' # No Color

# Script directory
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(dirname "$SCRIPT_DIR")"

# Change to repo root
cd "$REPO_ROOT"

# Load environment (required)
if [ -f ".env" ]; then
    # shellcheck source=/dev/null
    set -a
    source ".env"
    set +a
else
    echo -e "${RED}[ERROR]${NC} .env file not found in ${REPO_ROOT}"
    echo ""
    echo "Please create .env file first:"
    echo "  cp env/.env.example .env"
    echo "  nano .env"
    echo ""
    echo "Or run the bootstrap script:"
    echo "  ./scripts/bootstrap-homecore.sh"
    echo ""
    exit 1
fi

# -----------------------------------------------------------------------------
# Helper Functions
# -----------------------------------------------------------------------------

log_info() {
    echo -e "${BLUE}[INFO]${NC} $1"
}

log_success() {
    echo -e "${GREEN}[SUCCESS]${NC} $1"
}

log_warn() {
    echo -e "${YELLOW}[WARNING]${NC} $1"
}

log_error() {
    echo -e "${RED}[ERROR]${NC} $1"
}

show_help() {
    echo -e "${CYAN}Orion-Sentinel-HomeCore Operator CLI${NC}"
    echo ""
    echo "Usage: orionctl <command> [options]"
    echo ""
    echo "Commands:"
    echo "  up [stack] [--profile <name>]  Start services (default: core)"
    echo "  down [stack]                   Stop services"
    echo "  ps                             Show running services"
    echo "  logs <service> [--follow]      Show service logs"
    echo "  restart [stack]                Restart services"
    echo "  update                         Pull latest images and restart"
    echo "  validate                       Validate compose configuration"
    echo "  doctor                         Run health checks"
    echo "  backup                         Backup all data"
    echo "  help                           Show this help message"
    echo ""
    echo "Stacks:"
    echo "  homeassistant    Home Assistant only"
    echo "  mqtt             Mosquitto MQTT broker"
    echo "  zigbee           Zigbee2MQTT (requires mqtt)"
    echo "  nodered          Node-RED"
    echo "  esphome          ESPHome"
    echo "  mealie           Mealie recipe manager"
    echo ""
    echo "Bundles (shortcuts):"
    echo "  core             Home Assistant (default)"
    echo "  homeauto         Home Assistant + MQTT + Zigbee + Node-RED"
    echo "  apps             Mealie"
    echo "  all              All services"
    echo ""
    echo "Examples:"
    echo "  orionctl up                    # Start Home Assistant"
    echo "  orionctl up homeauto           # Start full home automation stack"
    echo "  orionctl up --profile mqtt     # Start Home Assistant + MQTT"
    echo "  orionctl logs homeassistant    # View Home Assistant logs"
    echo "  orionctl validate              # Validate compose files"
    echo "  orionctl doctor                # Run health checks"
    echo "  orionctl backup                # Backup all data"
    echo ""
}

# Map bundle names to profile arrays
# Sets the global PROFILE_ARGS array
get_profiles_for_bundle() {
    local bundle="$1"
    PROFILE_ARGS=()
    case "$bundle" in
        core|homeassistant)
            # No additional profiles needed
            ;;
        mqtt)
            PROFILE_ARGS=(--profile mqtt)
            ;;
        zigbee)
            PROFILE_ARGS=(--profile mqtt --profile zigbee)
            ;;
        nodered)
            PROFILE_ARGS=(--profile nodered)
            ;;
        esphome)
            PROFILE_ARGS=(--profile esphome)
            ;;
        mealie|apps)
            PROFILE_ARGS=(--profile mealie)
            ;;
        homeauto)
            PROFILE_ARGS=(--profile mqtt --profile zigbee --profile nodered)
            ;;
        all)
            PROFILE_ARGS=(--profile mqtt --profile zigbee --profile nodered --profile esphome --profile mealie)
            ;;
        *)
            # Unknown bundle, no profiles
            ;;
    esac
}

# -----------------------------------------------------------------------------
# Commands
# -----------------------------------------------------------------------------

cmd_up() {
    local -a profile_args=()
    local stack=""
    
    # Parse arguments
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --profile)
                if [[ -n "$2" && "$2" =~ ^[a-zA-Z0-9_-]+$ ]]; then
                    profile_args+=(--profile "$2")
                else
                    log_error "Invalid profile name: $2"
                    exit 1
                fi
                shift 2
                ;;
            -*)
                log_error "Unknown option: $1"
                exit 1
                ;;
            *)
                stack="$1"
                shift
                ;;
        esac
    done
    
    # If a stack/bundle name is provided, convert to profiles
    if [ -n "$stack" ]; then
        get_profiles_for_bundle "$stack"
        profile_args+=("${PROFILE_ARGS[@]}")
    fi
    
    log_info "Starting HomeCore services..."
    
    # Ensure networks exist
    if ! docker network inspect homecore_internal &> /dev/null; then
        log_info "Creating homecore_internal network..."
        docker network create homecore_internal
    fi
    
    if ! docker network inspect homecore_lan &> /dev/null; then
        log_info "Creating homecore_lan network..."
        docker network create homecore_lan
    fi
    
    # Run docker compose with profile arguments
    docker compose "${profile_args[@]}" up -d
    
    log_success "Services started!"
    echo ""
    cmd_ps
}

cmd_down() {
    local stack="$1"
    local -a profile_args=()
    
    if [ -n "$stack" ]; then
        get_profiles_for_bundle "$stack"
        profile_args=("${PROFILE_ARGS[@]}")
    fi
    
    log_info "Stopping HomeCore services..."
    
    docker compose "${profile_args[@]}" down
    
    log_success "Services stopped!"
}

cmd_ps() {
    echo -e "${CYAN}HomeCore Services Status${NC}"
    echo ""
    docker compose ps --format "table {{.Name}}\t{{.Status}}\t{{.Ports}}"
}

cmd_logs() {
    local service="$1"
    local follow_flag=""
    
    # Check for --follow flag
    if [ "$2" = "--follow" ] || [ "$2" = "-f" ]; then
        follow_flag="-f"
    fi
    
    if [ -z "$service" ]; then
        log_error "Please specify a service name"
        echo "Available services: homeassistant, mosquitto, zigbee2mqtt, nodered, esphome, mealie, mealie-db"
        exit 1
    fi
    
    docker compose logs ${follow_flag} "$service"
}

cmd_restart() {
    local stack="$1"
    local -a profile_args=()
    
    if [ -n "$stack" ]; then
        get_profiles_for_bundle "$stack"
        profile_args=("${PROFILE_ARGS[@]}")
    fi
    
    log_info "Restarting HomeCore services..."
    
    docker compose "${profile_args[@]}" restart
    
    log_success "Services restarted!"
}

cmd_update() {
    log_info "Pulling latest images..."
    
    # Pull all images
    docker compose pull
    
    log_info "Recreating services with new images..."
    # Note: This recreates all currently running services, maintaining their profiles
    docker compose up -d
    
    log_success "Services updated and restarted!"
    echo ""
    cmd_ps
}

cmd_doctor() {
    echo -e "${CYAN}============================================${NC}"
    echo -e "${CYAN}  HomeCore System Health Check              ${NC}"
    echo -e "${CYAN}============================================${NC}"
    echo ""
    
    # Run the doctor script
    "${SCRIPT_DIR}/doctor.sh"
}

cmd_validate() {
    log_info "Validating Docker Compose configuration..."
    
    # Check if .env file exists
    if [ ! -f "${REPO_ROOT}/.env" ]; then
        log_error ".env file not found!"
        echo ""
        echo "Please create .env file first:"
        echo "  cp env/.env.example .env"
        echo "  sudo nano .env"
        echo ""
        echo "Or run the bootstrap script:"
        echo "  ./scripts/bootstrap-homecore.sh"
        echo ""
        exit 1
    fi
    
    # Check if DATA_ROOT is writable
    DATA_ROOT="${DATA_ROOT:-/srv/orion/homecore}"
    if [ ! -d "$DATA_ROOT" ]; then
        log_error "DATA_ROOT does not exist: ${DATA_ROOT}"
        echo ""
        echo "Please run the bootstrap script first:"
        echo "  ./scripts/bootstrap-homecore.sh"
        echo ""
        exit 1
    fi
    
    if [ ! -w "$DATA_ROOT" ]; then
        log_error "DATA_ROOT is not writable: ${DATA_ROOT}"
        echo ""
        echo "Please fix permissions:"
        echo "  sudo chown -R \$USER:\$USER ${DATA_ROOT}"
        echo ""
        exit 1
    fi
    
    # Validate compose configuration
    log_info "Checking compose file syntax..."
    
    if docker compose config > /dev/null 2>&1; then
        log_success "Compose configuration is valid!"
        echo ""
        echo "Configuration summary:"
        docker compose config --services
    else
        log_error "Compose configuration has errors!"
        echo ""
        docker compose config
        exit 1
    fi
}

cmd_backup() {
    log_info "Starting backup..."
    "${SCRIPT_DIR}/backup.sh"
}

# -----------------------------------------------------------------------------
# Main
# -----------------------------------------------------------------------------

case "${1:-help}" in
    up)
        shift
        cmd_up "$@"
        ;;
    down)
        shift
        cmd_down "$@"
        ;;
    ps|status)
        cmd_ps
        ;;
    logs)
        shift
        cmd_logs "$@"
        ;;
    restart)
        shift
        cmd_restart "$@"
        ;;
    update)
        cmd_update
        ;;
    validate)
        cmd_validate
        ;;
    doctor|check)
        cmd_doctor
        ;;
    backup)
        cmd_backup
        ;;
    help|--help|-h)
        show_help
        ;;
    *)
        log_error "Unknown command: $1"
        echo ""
        show_help
        exit 1
        ;;
esac
