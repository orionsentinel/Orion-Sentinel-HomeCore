#!/bin/bash
# =============================================================================
# Orion-Sentinel-HomeCore Operator CLI (orionctl)
# =============================================================================
# A simple operator CLI for managing HomeCore services.
# =============================================================================

set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
NC='\033[0m' # No Color

# Script directory
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(dirname "$SCRIPT_DIR")"

# Change to repo root
cd "$REPO_ROOT"

# Load environment if exists
if [ -f ".env" ]; then
    # shellcheck source=/dev/null
    set -a
    source ".env"
    set +a
fi

# -----------------------------------------------------------------------------
# Helper Functions
# -----------------------------------------------------------------------------

log_info() {
    echo -e "${BLUE}[INFO]${NC} $1"
}

log_success() {
    echo -e "${GREEN}[SUCCESS]${NC} $1"
}

log_warn() {
    echo -e "${YELLOW}[WARNING]${NC} $1"
}

log_error() {
    echo -e "${RED}[ERROR]${NC} $1"
}

show_help() {
    echo -e "${CYAN}Orion-Sentinel-HomeCore Operator CLI${NC}"
    echo ""
    echo "Usage: orionctl <command> [options]"
    echo ""
    echo "Commands:"
    echo "  up [stack] [--profile <name>]  Start services (default: core)"
    echo "  down [stack]                   Stop services"
    echo "  ps                             Show running services"
    echo "  logs <service>                 Show service logs"
    echo "  restart [stack]                Restart services"
    echo "  update                         Pull latest images and restart"
    echo "  doctor                         Run health checks"
    echo "  help                           Show this help message"
    echo ""
    echo "Stacks:"
    echo "  homeassistant    Home Assistant only"
    echo "  mqtt             Mosquitto MQTT broker"
    echo "  zigbee           Zigbee2MQTT (requires mqtt)"
    echo "  nodered          Node-RED"
    echo "  esphome          ESPHome"
    echo "  mealie           Mealie recipe manager"
    echo ""
    echo "Bundles (shortcuts):"
    echo "  core             Home Assistant (default)"
    echo "  homeauto         Home Assistant + MQTT + Zigbee + Node-RED"
    echo "  apps             Mealie"
    echo "  all              All services"
    echo ""
    echo "Examples:"
    echo "  orionctl up                    # Start Home Assistant"
    echo "  orionctl up homeauto           # Start full home automation stack"
    echo "  orionctl up --profile mqtt     # Start Home Assistant + MQTT"
    echo "  orionctl logs homeassistant    # View Home Assistant logs"
    echo "  orionctl doctor                # Run health checks"
    echo ""
}

# Map bundle names to profiles
get_profiles_for_bundle() {
    local bundle="$1"
    case "$bundle" in
        core|homeassistant)
            echo ""
            ;;
        mqtt)
            echo "--profile mqtt"
            ;;
        zigbee)
            echo "--profile mqtt --profile zigbee"
            ;;
        nodered)
            echo "--profile nodered"
            ;;
        esphome)
            echo "--profile esphome"
            ;;
        mealie|apps)
            echo "--profile mealie"
            ;;
        homeauto)
            echo "--profile mqtt --profile zigbee --profile nodered"
            ;;
        all)
            echo "--profile mqtt --profile zigbee --profile nodered --profile esphome --profile mealie"
            ;;
        *)
            echo ""
            ;;
    esac
}

# -----------------------------------------------------------------------------
# Commands
# -----------------------------------------------------------------------------

cmd_up() {
    local profiles=""
    local stack=""
    
    # Parse arguments
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --profile)
                profiles="$profiles --profile $2"
                shift 2
                ;;
            -*)
                log_error "Unknown option: $1"
                exit 1
                ;;
            *)
                stack="$1"
                shift
                ;;
        esac
    done
    
    # If a stack/bundle name is provided, convert to profiles
    if [ -n "$stack" ]; then
        bundle_profiles=$(get_profiles_for_bundle "$stack")
        if [ -n "$bundle_profiles" ]; then
            profiles="$profiles $bundle_profiles"
        fi
    fi
    
    log_info "Starting HomeCore services..."
    
    # Ensure network exists
    if ! docker network inspect homecore_internal &> /dev/null; then
        log_info "Creating homecore_internal network..."
        docker network create homecore_internal
    fi
    
    # Build the command
    # shellcheck disable=SC2086
    docker compose $profiles up -d
    
    log_success "Services started!"
    echo ""
    cmd_ps
}

cmd_down() {
    local stack="$1"
    local profiles=""
    
    if [ -n "$stack" ]; then
        profiles=$(get_profiles_for_bundle "$stack")
    fi
    
    log_info "Stopping HomeCore services..."
    
    # shellcheck disable=SC2086
    docker compose $profiles down
    
    log_success "Services stopped!"
}

cmd_ps() {
    echo -e "${CYAN}HomeCore Services Status${NC}"
    echo ""
    docker compose ps --format "table {{.Name}}\t{{.Status}}\t{{.Ports}}"
}

cmd_logs() {
    local service="$1"
    local follow="${2:--f}"
    
    if [ -z "$service" ]; then
        log_error "Please specify a service name"
        echo "Available services: homeassistant, mosquitto, zigbee2mqtt, nodered, esphome, mealie, mealie-db"
        exit 1
    fi
    
    docker compose logs "$follow" "$service"
}

cmd_restart() {
    local stack="$1"
    local profiles=""
    
    if [ -n "$stack" ]; then
        profiles=$(get_profiles_for_bundle "$stack")
    fi
    
    log_info "Restarting HomeCore services..."
    
    # shellcheck disable=SC2086
    docker compose $profiles restart
    
    log_success "Services restarted!"
}

cmd_update() {
    log_info "Pulling latest images..."
    
    # Get list of running services
    running_services=$(docker compose ps --format "{{.Name}}" 2>/dev/null || echo "")
    
    # Pull all images
    docker compose pull
    
    if [ -n "$running_services" ]; then
        log_info "Restarting services with new images..."
        docker compose up -d
        log_success "Services updated and restarted!"
    else
        log_success "Images pulled. Start services with: orionctl up"
    fi
}

cmd_doctor() {
    echo -e "${CYAN}============================================${NC}"
    echo -e "${CYAN}  HomeCore System Health Check              ${NC}"
    echo -e "${CYAN}============================================${NC}"
    echo ""
    
    # Run the doctor script
    "${SCRIPT_DIR}/doctor.sh"
}

# -----------------------------------------------------------------------------
# Main
# -----------------------------------------------------------------------------

case "${1:-help}" in
    up)
        shift
        cmd_up "$@"
        ;;
    down)
        shift
        cmd_down "$@"
        ;;
    ps|status)
        cmd_ps
        ;;
    logs)
        shift
        cmd_logs "$@"
        ;;
    restart)
        shift
        cmd_restart "$@"
        ;;
    update)
        cmd_update
        ;;
    doctor|check)
        cmd_doctor
        ;;
    help|--help|-h)
        show_help
        ;;
    *)
        log_error "Unknown command: $1"
        echo ""
        show_help
        exit 1
        ;;
esac
