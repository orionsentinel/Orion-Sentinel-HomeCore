# =============================================================================
# Orion-Sentinel-HomeCore Profile Reference
# =============================================================================
# Profiles allow you to enable/disable optional services without editing
# compose files directly.
#
# Set profiles in your .env file using COMPOSE_PROFILES:
# Example: COMPOSE_PROFILES=mqtt,zigbee,nodered
#
# Or pass profiles directly to orionctl or docker compose:
# ./scripts/orionctl up --profile mqtt --profile zigbee
# docker compose --profile mqtt --profile zigbee up -d
# =============================================================================

# -----------------------------------------------------------------------------
# Available Profiles
# -----------------------------------------------------------------------------

# mqtt
# ----
# Enables: Mosquitto MQTT broker
# Port: 1883
# Use when: You have MQTT-based devices or need HA MQTT integration
# Required env: MQTT_PORT

# zigbee
# ------
# Enables: Zigbee2MQTT (requires mqtt profile)
# Port: 8080 (web interface)
# Use when: You have Zigbee devices and a USB Zigbee coordinator
# Required env: ZIGBEE_PORT, ZIGBEE_DEVICE

# nodered
# -------
# Enables: Node-RED for flow-based automation
# Port: 1880
# Use when: You need advanced automation beyond HA automations

# esphome
# -------
# Enables: ESPHome dashboard for ESP device management
# Port: 6052
# Use when: You have ESP8266/ESP32 devices to program

# mealie
# ------
# Enables: Mealie recipe manager + Postgres database
# Port: 9000
# Use when: You want a recipe/meal planning application

# immich
# ------
# Enables: Immich photo/video backup + Postgres + Valkey + machine learning
# Port: 2283
# Use when: You want a self-hosted Google Photos / iCloud Photos
# Required env: IMMICH_UPLOAD_LOCATION, IMMICH_DB_PASSWORD
# Note: Needs ~6GB RAM free for a smooth experience. Deploy with ./scripts/deploy-media.sh

# jellyfin
# --------
# Enables: Jellyfin media server
# Port: 8096
# Use when: You want to stream your own movies/TV/music
# Required env: MEDIA_ROOT
# Note: CPU-only transcoding on a Pi 5. Deploy with ./scripts/deploy-media.sh

# navidrome
# ---------
# Enables: Navidrome music server (Subsonic API)
# Port: 4533
# Use when: You want to stream your own music library to Subsonic apps
# Required env: MEDIA_ROOT (reads MEDIA_ROOT/Music)

# audiobookshelf
# --------------
# Enables: Audiobookshelf audiobook and podcast server
# Port: 13378
# Use when: You have audiobooks or want self-hosted podcast downloads
# Required env: MEDIA_ROOT (reads Audiobooks/, writes Podcasts/)

# arr
# ---
# Enables: qBittorrent, Prowlarr, Sonarr, Radarr, Bazarr, Seerr + disk guard
# Ports: 5080, 9696, 8989, 7878, 6767, 5055 (BitTorrent 6881 on all interfaces)
# Use when: You want download automation and a request page for the family
# Required env: MEDIA_ROOT, QBT_PASSWORD (generated by ./scripts/deploy-media.sh --arr)
# Note: Prowlarr starts with no indexers; which sources you add is your decision

# ha-hostnet
# ----------
# Enables: Home Assistant in host network mode
# Use when: You need mDNS/SSDP discovery for devices
# Note: Disables normal bridge networking for HA

# -----------------------------------------------------------------------------
# Recommended Profile Combinations
# -----------------------------------------------------------------------------

# Minimal (default - no profiles):
# Just Home Assistant
# COMPOSE_PROFILES=

# Home Automation:
# Full home automation stack with MQTT, Zigbee, and Node-RED
# COMPOSE_PROFILES=mqtt,zigbee,nodered

# Smart Home Complete:
# Everything including Mealie for recipes
# COMPOSE_PROFILES=mqtt,zigbee,nodered,esphome,mealie

# Media (photos, video, music, audiobooks):
# Usually started alongside whatever else runs, via ./scripts/deploy-media.sh
# COMPOSE_PROFILES=immich,jellyfin,navidrome,audiobookshelf

# Discovery Mode:
# Enable host networking for device discovery
# COMPOSE_PROFILES=ha-hostnet
