# =============================================================================
# Orion-Sentinel-HomeCore Environment Configuration
# =============================================================================
# Copy this file to .env and customize values as needed.
# DO NOT commit .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# General Settings
# -----------------------------------------------------------------------------
TZ=Europe/Amsterdam
# LAN IP for service binding (use your machine's LAN IP, e.g., 192.168.1.100)
# Default is local loopback for safety. Change to 0.0.0.0 ONLY if you understand the security implications.
HOST_IP=127.0.0.1
DATA_ROOT=/srv/orion/homecore

# User/Group IDs for file permissions (optional)
# PUID=1000
# PGID=1000

# -----------------------------------------------------------------------------
# Home Assistant
# -----------------------------------------------------------------------------
HA_PORT=8123

# -----------------------------------------------------------------------------
# Mosquitto MQTT (profile: mqtt)
# -----------------------------------------------------------------------------
MQTT_PORT=1883

# -----------------------------------------------------------------------------
# Zigbee2MQTT (profile: zigbee)
# -----------------------------------------------------------------------------
ZIGBEE_PORT=8080
ZIGBEE_DEVICE=/dev/ttyUSB0

# -----------------------------------------------------------------------------
# Node-RED (profile: nodered)
# -----------------------------------------------------------------------------
NODERED_PORT=1880

# -----------------------------------------------------------------------------
# ESPHome (profile: esphome)
# -----------------------------------------------------------------------------
ESPHOME_PORT=6052

# -----------------------------------------------------------------------------
# Mealie (profile: mealie)
# -----------------------------------------------------------------------------
MEALIE_PORT=9000
MEALIE_DB_PORT=5432

# Postgres credentials for Mealie (auto-generated by bootstrap script)
POSTGRES_USER=mealie
POSTGRES_PASSWORD=changeme
POSTGRES_DB=mealie

# Mealie application secret (auto-generated by bootstrap script)
MEALIE_SECRET_KEY=changeme

# -----------------------------------------------------------------------------
# Homepage Dashboard (profile: portal)
# -----------------------------------------------------------------------------
HOMEPAGE_IMAGE_TAG=latest
HOMEPAGE_PORT=3001

# -----------------------------------------------------------------------------
# Uptime Kuma (profile: status)
# -----------------------------------------------------------------------------
KUMA_IMAGE_TAG=1
KUMA_PORT=3001

# After setting up Uptime Kuma, create a Status Page and set the slug here
# This enables the Homepage widget integration
# KUMA_STATUS_SLUG=

# -----------------------------------------------------------------------------
# Multi-Node Configuration (Orion Ops Plane)
# -----------------------------------------------------------------------------
# IP addresses for all Orion nodes
# Update these with your actual node IPs

# HomeCore (this machine)
HOMECORE_NODE_IP=127.0.0.1

# DataAICore (Optiplex or similar - runs AI services + observability)
DATAAICORE_NODE_IP=192.168.1.10

# DNS Node (runs DNS services like Pi-hole, AdGuard Home, etc.)
DNS_NODE_IP=192.168.1.11

# NetSec Node (runs security services like firewall, VPN, IDS, etc.)
NETSEC_NODE_IP=192.168.1.12

# Remote Docker Socket Proxy Port
# Each node runs a docker-socket-proxy on this port (LAN-restricted)
REMOTE_DOCKER_PROXY_PORT=2376

# -----------------------------------------------------------------------------
# Observability Stack (on DataAICore)
# -----------------------------------------------------------------------------
# Grafana, Prometheus, and Loki run on DataAICore
# These are used for manual links in Homepage
GRAFANA_PORT=3000
PROM_PORT=9090
LOKI_PORT=3100

# -----------------------------------------------------------------------------
# Docker Compose Profiles
# -----------------------------------------------------------------------------
# Enable profiles by setting COMPOSE_PROFILES
# Example: COMPOSE_PROFILES=mqtt,zigbee,nodered,portal,status
# Available profiles: mqtt, zigbee, nodered, esphome, mealie, portal, status, ha-hostnet
# COMPOSE_PROFILES=
