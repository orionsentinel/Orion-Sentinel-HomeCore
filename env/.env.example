# =============================================================================
# Orion-Sentinel-HomeCore Environment Configuration
# =============================================================================
# Copy this file to .env and customize values as needed.
# DO NOT commit .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# General Settings
# -----------------------------------------------------------------------------
TZ=Europe/Amsterdam
# LAN IP for service binding (use your machine's LAN IP, e.g., 192.168.1.100)
# Default is local loopback for safety. Change to 0.0.0.0 ONLY if you understand the security implications.
HOST_IP=127.0.0.1
DATA_ROOT=/srv/orion/homecore

# User/Group IDs for file permissions (optional)
# PUID=1000
# PGID=1000

# -----------------------------------------------------------------------------
# Home Assistant
# -----------------------------------------------------------------------------
HA_PORT=8123

# -----------------------------------------------------------------------------
# Mosquitto MQTT (profile: mqtt)
# -----------------------------------------------------------------------------
MQTT_PORT=1883

# -----------------------------------------------------------------------------
# Zigbee2MQTT (profile: zigbee)
# -----------------------------------------------------------------------------
ZIGBEE_PORT=8080
ZIGBEE_DEVICE=/dev/ttyUSB0

# -----------------------------------------------------------------------------
# Node-RED (profile: nodered)
# -----------------------------------------------------------------------------
NODERED_PORT=1880

# -----------------------------------------------------------------------------
# ESPHome (profile: esphome)
# -----------------------------------------------------------------------------
ESPHOME_PORT=6052

# -----------------------------------------------------------------------------
# Mealie (profile: mealie)
# -----------------------------------------------------------------------------
MEALIE_PORT=9000
MEALIE_DB_PORT=5432

# Postgres credentials for Mealie (auto-generated by bootstrap script)
POSTGRES_USER=mealie
POSTGRES_PASSWORD=changeme
POSTGRES_DB=mealie

# Mealie application secret (auto-generated by bootstrap script)
MEALIE_SECRET_KEY=changeme

# -----------------------------------------------------------------------------
# Media: Immich (profile: immich) and Jellyfin (profile: jellyfin)
# -----------------------------------------------------------------------------
# Deploy with ./scripts/deploy-media.sh, which adds any of these keys missing
# from an existing .env and generates IMMICH_DB_PASSWORD. See MEDIA.md.
#
# Bulk data belongs on a large external SSD/HDD, not the OS disk.
# Immich: originals, thumbnails, encoded video, nightly DB dumps
IMMICH_UPLOAD_LOCATION=/srv/orion/media/immich
# Jellyfin library (expects Movies/, TV/, Music/ subfolders), mounted read-only
MEDIA_ROOT=/srv/orion/media/library
# Immich's database and both services' config live under DATA_ROOT (keep on SSD/NVMe)

IMMICH_VERSION=v3.3.5
IMMICH_PORT=2283
# Letters and digits only - Immich rejects other characters (auto-generated)
IMMICH_DB_PASSWORD=changeme
# Machine-learning container limits (faces, smart search, OCR). Peak with all
# models loaded is ~3GB - below 4G it gets OOM-killed mid-job.
IMMICH_ML_THREADS=2
IMMICH_ML_MEM_LIMIT=4G

JELLYFIN_VERSION=12.4
JELLYFIN_PORT=8096
JELLYFIN_MEM_LIMIT=2G
# Jellyfin-only bind address (defaults to HOST_IP). Set to the LAN IP so TVs
# without Tailscale can connect while other services stay on loopback.
# JELLYFIN_HOST_IP=192.168.1.100

# Tailscale HTTPS ports used by: ./scripts/deploy-media.sh --tailscale
IMMICH_TAILSCALE_PORT=14443
JELLYFIN_TAILSCALE_PORT=16443

# -----------------------------------------------------------------------------
# Docker Compose Profiles
# -----------------------------------------------------------------------------
# Enable profiles by setting COMPOSE_PROFILES
# Example: COMPOSE_PROFILES=mqtt,zigbee,nodered
# Available profiles: mqtt, zigbee, nodered, esphome, mealie, ha-hostnet, immich, jellyfin
# COMPOSE_PROFILES=
