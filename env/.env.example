# =============================================================================
# Orion-Sentinel-HomeCore Environment Configuration
# =============================================================================
# Copy this file to .env and customize values as needed.
# DO NOT commit .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# General Settings
# -----------------------------------------------------------------------------
TZ=Europe/Amsterdam
# LAN IP for service binding (use your machine's LAN IP, e.g., 192.168.1.100)
# Default is local loopback for safety. Change to 0.0.0.0 ONLY if you understand the security implications.
HOST_IP=127.0.0.1
DATA_ROOT=/srv/orion/homecore

# User/Group IDs for file permissions (optional)
# PUID=1000
# PGID=1000

# -----------------------------------------------------------------------------
# Home Assistant
# -----------------------------------------------------------------------------
HA_PORT=8123

# -----------------------------------------------------------------------------
# Mosquitto MQTT (profile: mqtt)
# -----------------------------------------------------------------------------
MQTT_PORT=1883

# -----------------------------------------------------------------------------
# Zigbee2MQTT (profile: zigbee)
# -----------------------------------------------------------------------------
ZIGBEE_PORT=8080
ZIGBEE_DEVICE=/dev/ttyUSB0

# -----------------------------------------------------------------------------
# Node-RED (profile: nodered)
# -----------------------------------------------------------------------------
NODERED_PORT=1880

# -----------------------------------------------------------------------------
# ESPHome (profile: esphome)
# -----------------------------------------------------------------------------
ESPHOME_PORT=6052

# -----------------------------------------------------------------------------
# Mealie (profile: mealie)
# -----------------------------------------------------------------------------
MEALIE_PORT=9000
MEALIE_DB_PORT=5432

# Postgres credentials for Mealie (auto-generated by bootstrap script)
POSTGRES_USER=mealie
POSTGRES_PASSWORD=changeme
POSTGRES_DB=mealie

# Mealie application secret (auto-generated by bootstrap script)
MEALIE_SECRET_KEY=changeme

# -----------------------------------------------------------------------------
# Media: Immich, Jellyfin, Navidrome, Audiobookshelf (profiles of the same names)
# -----------------------------------------------------------------------------
# Deploy with ./scripts/deploy-media.sh, which adds any of these keys missing
# from an existing .env and generates IMMICH_DB_PASSWORD. See MEDIA.md.
#
# Bulk data belongs on a large external SSD/HDD, not the OS disk.
# Immich: originals, thumbnails, encoded video, nightly DB dumps
IMMICH_UPLOAD_LOCATION=/srv/orion/media/immich
# Shared library: Movies/ TV/ Music/ (Jellyfin), Music/ (Navidrome),
# Audiobooks/ Podcasts/ (Audiobookshelf). Missing subfolders are created.
MEDIA_ROOT=/srv/orion/media/library
# Immich's database and every service's config live under DATA_ROOT (keep on SSD/NVMe)

IMMICH_VERSION=v3.3.5
IMMICH_PORT=2283
# Letters and digits only - Immich rejects other characters (auto-generated)
IMMICH_DB_PASSWORD=changeme
# Machine-learning container limits (faces, smart search, OCR). Peak with all
# models loaded is ~3GB - below 4G it gets OOM-killed mid-job.
IMMICH_ML_THREADS=2
IMMICH_ML_MEM_LIMIT=4G

JELLYFIN_VERSION=12.4
JELLYFIN_PORT=8096
JELLYFIN_MEM_LIMIT=2G
# Jellyfin-only bind address (defaults to HOST_IP). Set to the LAN IP so TVs
# without Tailscale can connect while other services stay on loopback.
# JELLYFIN_HOST_IP=192.168.1.100

NAVIDROME_VERSION=0.64.2
NAVIDROME_PORT=4533

AUDIOBOOKSHELF_VERSION=2.37.2
AUDIOBOOKSHELF_PORT=13378

# Tailscale HTTPS ports used by: ./scripts/deploy-media.sh --tailscale
IMMICH_TAILSCALE_PORT=14443
JELLYFIN_TAILSCALE_PORT=16443
NAVIDROME_TAILSCALE_PORT=18443
AUDIOBOOKSHELF_TAILSCALE_PORT=20443

# -----------------------------------------------------------------------------
# Download automation (profile: arr) - opt-in: ./scripts/deploy-media.sh --arr
# -----------------------------------------------------------------------------
# qBittorrent, Prowlarr, Sonarr, Radarr, Bazarr, Seerr. All of them use
# MEDIA_ROOT as /data (downloads land in MEDIA_ROOT/Downloads), so imports
# are hardlinks, not copies. See MEDIA.md "Download automation".
QBT_VERSION=5.3.0
QBT_PORT=5080
QBT_TORRENT_PORT=6881
QBT_USERNAME=admin
# Letters and digits; generated and seeded into a fresh qBittorrent config
QBT_PASSWORD=changeme
PROWLARR_VERSION=2.6.5
PROWLARR_PORT=9696
SONARR_VERSION=4.0.20
SONARR_PORT=8989
RADARR_VERSION=6.4.4
RADARR_PORT=7878
BAZARR_VERSION=1.6.2
BAZARR_PORT=6767
SEERR_VERSION=v3.5.1
SEERR_PORT=5055
# Disk guard: stop every torrent when the library drive has less free than this
ARR_MIN_FREE_GB=100

SEERR_TAILSCALE_PORT=22443
SONARR_TAILSCALE_PORT=24443
RADARR_TAILSCALE_PORT=26443
PROWLARR_TAILSCALE_PORT=28443
BAZARR_TAILSCALE_PORT=30443
QBT_TAILSCALE_PORT=32443

# -----------------------------------------------------------------------------
# Docker Compose Profiles
# -----------------------------------------------------------------------------
# Enable profiles by setting COMPOSE_PROFILES
# Example: COMPOSE_PROFILES=mqtt,zigbee,nodered
# Available profiles: mqtt, zigbee, nodered, esphome, mealie, ha-hostnet, immich, jellyfin, navidrome, audiobookshelf, arr
# COMPOSE_PROFILES=
