# =============================================================================
# Flight Intelligence Stack - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values
#
# Usage: docker compose --profile flight-intel up -d

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
POSTGRES_USER=flightintel
POSTGRES_PASSWORD=change_me_secure_password
POSTGRES_DB=flightintel
POSTGRES_HOST=flight-postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://flightintel:change_me_secure_password@flight-postgres:5432/flightintel

# -----------------------------------------------------------------------------
# Redis Configuration (optional, only if using caching)
# -----------------------------------------------------------------------------
REDIS_URL=redis://flight-redis:6379/0
REDIS_ENABLED=false

# -----------------------------------------------------------------------------
# API Configuration
# -----------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_KEY=change_me_secure_api_key_for_trigger_endpoints
API_CORS_ORIGINS=http://localhost:8501,http://localhost:8000

# -----------------------------------------------------------------------------
# UI Configuration
# -----------------------------------------------------------------------------
UI_PORT=8501
STREAMLIT_SERVER_HEADLESS=true

# -----------------------------------------------------------------------------
# Collector Configuration
# -----------------------------------------------------------------------------
# Schedule in cron format (default: daily at 03:30)
COLLECTOR_SCHEDULE=0 3 * * *
COLLECTOR_ENABLED=true
COLLECTOR_TIMEOUT_SECONDS=3600
COLLECTOR_BATCH_SIZE=10

# -----------------------------------------------------------------------------
# Flight Provider Configuration
# -----------------------------------------------------------------------------
# Supported providers: mock, amadeus
# Mock provider always works and generates synthetic data for testing
DEFAULT_PROVIDER=mock

# Amadeus API credentials (optional, falls back to mock if not provided)
# Get your credentials from https://developers.amadeus.com
AMADEUS_API_KEY=
AMADEUS_API_SECRET=
AMADEUS_BASE_URL=https://test.api.amadeus.com

# -----------------------------------------------------------------------------
# Search Configuration
# -----------------------------------------------------------------------------
# Default airports for NL/BE origins
DEFAULT_ORIGINS=AMS,EIN,RTM,BRU
# Crete destinations
DEFAULT_DESTINATIONS=HER,CHQ
# Search window (days from now)
SEARCH_START_DAYS_AHEAD=7
SEARCH_END_DAYS_AHEAD=180
# Stay duration
MIN_STAY_DAYS=7
MAX_STAY_DAYS=21
# Flight preferences
DEFAULT_CABIN=ECONOMY
MAX_STOPS=2
CURRENCY=EUR

# -----------------------------------------------------------------------------
# Recommendation Engine
# -----------------------------------------------------------------------------
RECO_HISTORY_WINDOW_DAYS=60
RECO_BUY_MARGIN=0.05
RECO_MEDIAN_DISCOUNT=0.10
RECO_TREND_THRESHOLD=-0.5

# -----------------------------------------------------------------------------
# LLM Agent Configuration (optional)
# -----------------------------------------------------------------------------
AGENT_ENABLED=false
# Ollama endpoint (only if running ollama service)
OLLAMA_BASE_URL=http://flight-ollama:11434
OLLAMA_MODEL=llama2

# -----------------------------------------------------------------------------
# Observability Configuration
# -----------------------------------------------------------------------------
# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=/var/log/flight-intel/app.log

# Prometheus metrics
METRICS_ENABLED=true
METRICS_PORT=9090

# -----------------------------------------------------------------------------
# Alerts Configuration (optional, profile: alerts)
# -----------------------------------------------------------------------------
ALERTS_ENABLED=false
NTFY_URL=http://flight-ntfy:80
NTFY_TOPIC=flight-intel-alerts

# Telegram (alternative to ntfy)
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email (alternative to ntfy)
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=

# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------
# Set to production for production deployments
ENVIRONMENT=development

# JWT secret for future auth features
JWT_SECRET=change_me_random_jwt_secret_at_least_32_chars

# -----------------------------------------------------------------------------
# Resource Limits (for docker-compose)
# -----------------------------------------------------------------------------
API_MEM_LIMIT=512m
UI_MEM_LIMIT=512m
COLLECTOR_MEM_LIMIT=512m
POSTGRES_MEM_LIMIT=1g

# -----------------------------------------------------------------------------
# Host Configuration
# -----------------------------------------------------------------------------
# Bind to localhost for maximum security, or set to 0.0.0.0 for LAN access
HOST_IP=127.0.0.1
